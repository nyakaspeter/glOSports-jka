diff --git a/shared/sdl/sdl_glos.cpp b/shared/sdl/sdl_glos.cpp
new file mode 100644
index 0000000..c9d6112
--- /dev/null
+++ b/shared/sdl/sdl_glos.cpp
@@ -0,0 +1,256 @@
+/*
+sdl_glos.cpp: the GL window for ARM's closed Mali-400 driver (r6p2 "fbdev"
+libMali.so) on goodluckOS: a GLES 1.1 context on EGL drawing to /dev/fb0.
+ARM's driver has no GBM/KMS, so SDL keeps only input and sound here (its
+video runs on the "dummy" driver); see the port's glos-gpu for the driver switch.
+EGL is loaded at runtime, so the binary doesn't depend on it.
+*/
+#ifdef GLOS_GLES1
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "qcommon/qcommon.h"
+#include "sdl_glos.h"
+
+typedef void *EGLDisplay, *EGLConfig, *EGLSurface, *EGLContext;
+typedef int EGLint;
+typedef unsigned int EGLBoolean;
+
+// ARM's fbdev native window type (EGL/fbdev_window.h).
+struct fbdev_window {
+	unsigned short width;
+	unsigned short height;
+};
+
+#define EGL_DEFAULT_DISPLAY ((void*)0)
+#define EGL_NO_CONTEXT ((EGLContext)0)
+#define EGL_NONE 0x3038
+#define EGL_RED_SIZE 0x3024
+#define EGL_GREEN_SIZE 0x3023
+#define EGL_BLUE_SIZE 0x3022
+#define EGL_DEPTH_SIZE 0x3025
+#define EGL_STENCIL_SIZE 0x3026
+#define EGL_SURFACE_TYPE 0x3033
+#define EGL_WINDOW_BIT 0x0004
+#define EGL_RENDERABLE_TYPE 0x3040
+#define EGL_OPENGL_ES_BIT 0x0001
+#define EGL_CONTEXT_CLIENT_VERSION 0x3098
+
+static struct {
+	EGLDisplay (*GetDisplay)(void *);
+	EGLBoolean (*Initialize)(EGLDisplay, EGLint *, EGLint *);
+	EGLBoolean (*ChooseConfig)(EGLDisplay, const EGLint *, EGLConfig *, EGLint, EGLint *);
+	EGLSurface (*CreateWindowSurface)(EGLDisplay, EGLConfig, void *, const EGLint *);
+	EGLContext (*CreateContext)(EGLDisplay, EGLConfig, EGLContext, const EGLint *);
+	EGLBoolean (*MakeCurrent)(EGLDisplay, EGLSurface, EGLSurface, EGLContext);
+	EGLBoolean (*SwapBuffers)(EGLDisplay, EGLSurface);
+	EGLBoolean (*SwapInterval)(EGLDisplay, EGLint);
+	EGLBoolean (*DestroySurface)(EGLDisplay, EGLSurface);
+	EGLBoolean (*DestroyContext)(EGLDisplay, EGLContext);
+	EGLBoolean (*Terminate)(EGLDisplay);
+	EGLint (*GetError)(void);
+} egl;
+
+static void *maliLib;
+static EGLDisplay display;
+static EGLSurface surface;
+static EGLContext context;
+static fbdev_window nativeWindow;
+
+qboolean GLOS_GetScreenSize( int *w, int *h )
+{
+	struct fb_var_screeninfo vi;
+	int fd = open( "/dev/fb0", O_RDONLY );
+	if ( fd < 0 || ioctl( fd, FBIOGET_VSCREENINFO, &vi ) < 0 ) {
+		if ( fd >= 0 )
+			close( fd );
+		Com_Printf( "glos: can't read /dev/fb0\n" );
+		return qfalse;
+	}
+	close( fd );
+	*w = vi.xres;
+	*h = vi.yres;
+	Com_Printf( "glos: fbdev %dx%d (virtual %dx%d, %d bpp)\n", vi.xres, vi.yres, vi.xres_virtual, vi.yres_virtual, vi.bits_per_pixel );
+	return qtrue;
+}
+
+qboolean GLOS_Start( int w, int h, int depthBits, int stencilBits )
+{
+	if ( access( "/dev/mali", F_OK ) != 0 ) {
+		Com_Printf( "glos: /dev/mali missing: start through ./glos/glos-gpu run mali\n" );
+		return qfalse;
+	}
+	maliLib = dlopen( "libMali.so", RTLD_NOW | RTLD_GLOBAL );
+	if ( !maliLib ) {
+		Com_Printf( "glos: can't load libMali.so: %s\n", dlerror() );
+		return qfalse;
+	}
+#define LOAD(f) *(void**)&egl.f = dlsym( maliLib, "egl" #f ); if ( !egl.f ) { Com_Printf( "glos: missing egl" #f "\n" ); return qfalse; }
+	LOAD(GetDisplay) LOAD(Initialize) LOAD(ChooseConfig) LOAD(CreateWindowSurface)
+	LOAD(CreateContext) LOAD(MakeCurrent) LOAD(SwapBuffers) LOAD(SwapInterval)
+	LOAD(DestroySurface) LOAD(DestroyContext) LOAD(Terminate) LOAD(GetError)
+#undef LOAD
+
+	display = egl.GetDisplay( EGL_DEFAULT_DISPLAY );
+	EGLint major, minor;
+	if ( !display || !egl.Initialize( display, &major, &minor ) ) {
+		Com_Printf( "glos: eglInitialize failed 0x%x\n", egl.GetError() );
+		return qfalse;
+	}
+	const EGLint attribs[] = {
+		EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_ES_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8,
+		EGL_DEPTH_SIZE, depthBits, EGL_STENCIL_SIZE, stencilBits,
+		EGL_NONE
+	};
+	EGLConfig config;
+	EGLint n = 0;
+	if ( !egl.ChooseConfig( display, attribs, &config, 1, &n ) || n < 1 ) {
+		Com_Printf( "glos: no EGL config 0x%x\n", egl.GetError() );
+		return qfalse;
+	}
+	nativeWindow.width = w;
+	nativeWindow.height = h;
+	surface = egl.CreateWindowSurface( display, config, &nativeWindow, NULL );
+	const EGLint ctxAttribs[] = { EGL_CONTEXT_CLIENT_VERSION, 1, EGL_NONE };
+	context = egl.CreateContext( display, config, EGL_NO_CONTEXT, ctxAttribs );
+	if ( !surface || !context || !egl.MakeCurrent( display, surface, surface, context ) ) {
+		Com_Printf( "glos: surface/context failed 0x%x\n", egl.GetError() );
+		return qfalse;
+	}
+	Com_Printf( "glos: EGL %d.%d, GLES 1.1 context, %dx%d\n", major, minor, w, h );
+	return qtrue;
+}
+
+/*
+Tear-free flips. ARM's fbdev EGL returns from eglSwapBuffers at once and
+flips (FBIOPAN_DISPLAY, which returns at the vblank) on a thread of its own.
+With two buffers the GPU would then draw the next frame into the one still
+on screen: tearing, and a flicker between two frames. So each frame waits
+before its flush until the previous frame's flip has landed (JK2_FLIP_WAIT=0
+turns it off; JKA_ in the Jedi Academy build). The flips are counted here: the binary exports ioctl, so
+libMali's calls land in this one. From ga36-maxpayne-port.
+JK2_LOG_FPS=1 (JKA_LOG_FPS) logs frames per second and the wait twice a second.
+*/
+#ifdef JK2_MODE
+#define GLOS_ENV(name) "JK2_" name
+#else
+#define GLOS_ENV(name) "JKA_" name
+#endif
+
+static pthread_mutex_t flipLock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t flipCond = PTHREAD_COND_INITIALIZER;
+static unsigned flipsDone, swapsDone;
+
+extern "C" __attribute__(( visibility( "default" ) )) int ioctl( int fd, unsigned long request, ... )
+{
+	static int (*real)( int, unsigned long, void * );
+	if ( !real )
+		real = (int (*)( int, unsigned long, void * ))dlsym( RTLD_NEXT, "ioctl" );
+	va_list ap;
+	va_start( ap, request );
+	void *arg = va_arg( ap, void * );
+	va_end( ap );
+	int r = real( fd, request, arg );
+	if ( request == FBIOPAN_DISPLAY ) {
+		int e = errno;
+		pthread_mutex_lock( &flipLock );
+		flipsDone++;
+		pthread_cond_broadcast( &flipCond );
+		pthread_mutex_unlock( &flipLock );
+		errno = e;
+	}
+	return r;
+}
+
+static void WaitPreviousFlip( void )
+{
+	struct timespec t;
+	clock_gettime( CLOCK_REALTIME, &t );
+	t.tv_nsec += 100 * 1000000; // never hang on a flip that doesn't come
+	if ( t.tv_nsec >= 1000000000 ) {
+		t.tv_sec++;
+		t.tv_nsec -= 1000000000;
+	}
+	pthread_mutex_lock( &flipLock );
+	// a flip that comes late stays owed: counting it as done would let every
+	// later frame tear
+	while ( (int)( flipsDone - swapsDone ) < 0 )
+		if ( pthread_cond_timedwait( &flipCond, &flipLock, &t ) == ETIMEDOUT )
+			break;
+	pthread_mutex_unlock( &flipLock );
+}
+
+static double NowMs( void )
+{
+	struct timespec t;
+	clock_gettime( CLOCK_MONOTONIC, &t );
+	return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+void GLOS_Swap( void )
+{
+	static int flipWait = -1, logFps;
+	static double windowStart, waitMs;
+	static int frames;
+	if ( flipWait < 0 ) {
+		const char *v = getenv( GLOS_ENV( "FLIP_WAIT" ) );
+		flipWait = !( v && *v == '0' );
+		v = getenv( GLOS_ENV( "LOG_FPS" ) );
+		logFps = v && *v && *v != '0';
+		// the driver flips once when the surface is made: count from here
+		pthread_mutex_lock( &flipLock );
+		flipsDone = swapsDone = 0;
+		pthread_mutex_unlock( &flipLock );
+		windowStart = NowMs();
+	} else if ( flipWait ) {
+		double t0 = logFps ? NowMs() : 0;
+		WaitPreviousFlip();
+		if ( logFps )
+			waitMs += NowMs() - t0;
+	}
+	egl.SwapBuffers( display, surface );
+	pthread_mutex_lock( &flipLock );
+	swapsDone++;
+	pthread_mutex_unlock( &flipLock );
+	if ( logFps ) {
+		frames++;
+		double now = NowMs();
+		if ( now - windowStart >= 500.0 ) {
+			Com_Printf( "glos: FPS %.1f, flip wait %.1f ms/frame\n", frames * 1000.0 / ( now - windowStart ), waitMs / frames );
+			frames = 0;
+			waitMs = 0;
+			windowStart = now;
+		}
+	}
+}
+
+void GLOS_SetSwapInterval( int interval )
+{
+	egl.SwapInterval( display, interval );
+}
+
+void GLOS_Stop( void )
+{
+	if ( !display )
+		return;
+	egl.MakeCurrent( display, NULL, NULL, EGL_NO_CONTEXT );
+	if ( context )
+		egl.DestroyContext( display, context );
+	if ( surface )
+		egl.DestroySurface( display, surface );
+	egl.Terminate( display );
+	display = surface = context = NULL;
+}
+
+#endif // GLOS_GLES1
diff --git a/shared/sdl/sdl_glos.h b/shared/sdl/sdl_glos.h

+void glos_ClearStencil( GLint s ) { esClearStencil( s ); }
+void glos_ColorMask( GLboolean r, GLboolean g, GLboolean b, GLboolean a ) { esColorMask( r, g, b, a ); }
+void glos_CullFace( GLenum m ) { esCullFace( m ); }
+void glos_DeleteTextures( GLsizei n, const GLuint *t ) { esDeleteTextures( n, t ); }
+void glos_DepthFunc( GLenum f ) { esDepthFunc( f ); }
+void glos_DepthMask( GLboolean f ) { esDepthMask( f ); }
+void glos_Finish( void ) { esFinish(); }
+void glos_Flush( void ) { esFlush(); }
+void glos_FrontFace( GLenum m ) { esFrontFace( m ); }
+void glos_GenTextures( GLsizei n, GLuint *t ) { esGenTextures( n, t ); }
+GLenum glos_GetError( void ) { return esGetError(); }
+void glos_GetFloatv( GLenum p, GLfloat *v ) { esGetFloatv( p, v ); }
+void glos_GetBooleanv( GLenum p, GLboolean *v ) { esGetBooleanv( p, v ); }
+void glos_Hint( GLenum t, GLenum m ) { esHint( t, m ); }
+GLboolean glos_IsTexture( GLuint t ) { return esIsTexture( t ); }
+void glos_LineWidth( GLfloat w ) { esLineWidth( w ); }
+void glos_LoadIdentity( void ) { esLoadIdentity(); }
+void glos_LoadMatrixf( const GLfloat *m ) { esLoadMatrixf( m ); }
+void glos_MatrixMode( GLenum m ) { esMatrixMode( m ); }
+void glos_MultMatrixf( const GLfloat *m ) { esMultMatrixf( m ); }
+void glos_PointSize( GLfloat s ) { esPointSize( s ); }
+void glos_PolygonOffset( GLfloat f, GLfloat u ) { esPolygonOffset( f, u ); }
+void glos_PopMatrix( void ) { esPopMatrix(); }
+void glos_PushMatrix( void ) { esPushMatrix(); }
+void glos_Rotatef( GLfloat a, GLfloat x, GLfloat y, GLfloat z ) { esRotatef( a, x, y, z ); }
+void glos_Scalef( GLfloat x, GLfloat y, GLfloat z ) { esScalef( x, y, z ); }
+void glos_Scissor( GLint x, GLint y, GLsizei w, GLsizei h ) { esScissor( x, y, w, h ); }
+void glos_ShadeModel( GLenum m ) { esShadeModel( m ); }
+void glos_StencilFunc( GLenum f, GLint r, GLuint m ) { esStencilFunc( f, r, m ); }
+void glos_StencilMask( GLuint m ) { esStencilMask( m ); }
+void glos_StencilOp( GLenum f, GLenum zf, GLenum zp ) { esStencilOp( f, zf, zp ); }
+void glos_Translatef( GLfloat x, GLfloat y, GLfloat z ) { esTranslatef( x, y, z ); }
+void glos_Viewport( GLint x, GLint y, GLsizei w, GLsizei h ) { esViewport( x, y, w, h ); }
+void glos_PixelStorei( GLenum p, GLint v ) { esPixelStorei( p, v ); }
+void glos_Normal3f( GLfloat x, GLfloat y, GLfloat z ) { esNormal3f( x, y, z ); }
+
+void *glos_GetProcAddress( const char *name )
+{
+	if ( !strcmp( name, "glActiveTextureARB" ) ) return (void *)glos_ActiveTexture;
+	if ( !strcmp( name, "glClientActiveTextureARB" ) ) return (void *)glos_ClientActiveTexture;
+	if ( !strcmp( name, "glMultiTexCoord2fARB" ) ) return (void *)glos_MultiTexCoord2f;
+	return NULL;
+}
+

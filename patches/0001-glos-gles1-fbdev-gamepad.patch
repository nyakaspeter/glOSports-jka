@@ -0,0 +1,16 @@
+#pragma once
+// GLES 1.1 window on ARM's Mali driver (EGL on /dev/fb0), see sdl_glos.cpp.
+#ifdef GLOS_GLES1
+qboolean GLOS_GetScreenSize( int *w, int *h );
+qboolean GLOS_Start( int w, int h, int depthBits, int stencilBits );
+void GLOS_Swap( void );
+void GLOS_SetSwapInterval( int interval );
+void GLOS_Stop( void );
+
+// twin-stick gamepad, sdl_glospad.cpp
+extern float glosPadMove[2], glosPadLook[2], glosLookSpeed;
+extern qboolean glosPadActive;
+void GLOS_PadInit( void );
+void GLOS_PadShutdown( void );
+qboolean GLOS_PadFrame( int frameMsec );
+#endif
diff --git a/shared/sdl/sdl_glospad.cpp b/shared/sdl/sdl_glospad.cpp
new file mode 100644
index 0000000..7ca46a2
--- /dev/null
+++ b/shared/sdl/sdl_glospad.cpp
@@ -0,0 +1,188 @@
+/*
+sdl_glospad.cpp: twin-stick gamepad for goodluckOS (the GA36-MB's pad through
+SDL's game controller API, layout from SDL_GAMECONTROLLERCONFIG in start.sh).
+
+In game: left stick moves (analog), right stick aims (CL_JoystickMove reads
+glosPadMove / glosPadLook), buttons are the keys JOY1..JOY15 that glos-pad.cfg
+binds, Start is Escape. In menus: the left stick moves the cursor, A clicks,
+B and Start go back, the d-pad sends the cursor keys.
+
+Stick shaping, from start.sh (JK2_ in the Jedi Outcast build, JKA_ in Jedi Academy's):
+  JKA_STICK_SCALE     multiplies stick values (the GA36-MB's sticks reach ~2/3)
+  JKA_STICK_DEADZONE  radial dead zone after scaling (0..1)
+  JKA_LOOK_SPEED      turn rate at full right-stick deflection, degrees/second
+  JKA_LOOK_CURVE      response exponent for the right stick (1 = linear)
+*/
+#ifdef GLOS_GLES1
+
+#include <SDL.h>
+#include <math.h>
+#include <stdlib.h>
+
+#include "qcommon/qcommon.h"
+#include "client/client.h"
+#include "sys/sys_local.h"
+#include "sdl_glos.h"
+
+float glosPadMove[2], glosPadLook[2];
+float glosLookSpeed = 180.0f;
+qboolean glosPadActive;
+
+static SDL_GameController *pad;
+static float stickScale = 1.0f, deadZone = 0.12f, lookCurve = 2.0f;
+static bool held[SDL_CONTROLLER_BUTTON_MAX];
+static int heldKey[SDL_CONTROLLER_BUTTON_MAX];
+static float cursorFrac[2];
+
+#ifdef JK2_MODE
+#define PAD_ENV(name) "JK2_" name
+#else
+#define PAD_ENV(name) "JKA_" name
+#endif
+
+static float EnvFloat( const char *name, float def )
+{
+	const char *v = getenv( name );
+	return v && *v ? (float)atof( v ) : def;
+}
+
+void GLOS_PadInit( void )
+{
+	stickScale = EnvFloat( PAD_ENV( "STICK_SCALE" ), 1.0f );
+	deadZone = EnvFloat( PAD_ENV( "STICK_DEADZONE" ), 0.12f );
+	glosLookSpeed = EnvFloat( PAD_ENV( "LOOK_SPEED" ), 180.0f );
+	lookCurve = EnvFloat( PAD_ENV( "LOOK_CURVE" ), 2.0f );
+
+	if ( !SDL_WasInit( SDL_INIT_GAMECONTROLLER ) && SDL_InitSubSystem( SDL_INIT_GAMECONTROLLER ) < 0 ) {
+		Com_Printf( "glos pad: SDL_INIT_GAMECONTROLLER failed: %s\n", SDL_GetError() );
+		return;
+	}
+	for ( int i = 0; i < SDL_NumJoysticks(); i++ ) {
+		if ( SDL_IsGameController( i ) && ( pad = SDL_GameControllerOpen( i ) ) != NULL ) {
+			Com_Printf( "glos pad: %s (scale %.2f, dead zone %.2f, look %.0f deg/s, curve %.1f)\n",
+				SDL_GameControllerName( pad ), stickScale, deadZone, glosLookSpeed, lookCurve );
+			glosPadActive = qtrue;
+			return;
+		}
+	}
+	Com_Printf( "glos pad: no game controller\n" );
+}
+
+void GLOS_PadShutdown( void )
+{
+	if ( pad )
+		SDL_GameControllerClose( pad );
+	pad = NULL;
+	glosPadActive = qfalse;
+}
+
+// Scaled stick with a radial dead zone, rescaled so the edge of the dead zone is 0.
+static void ReadStick( SDL_GameControllerAxis ax, SDL_GameControllerAxis ay, float out[2] )
+{
+	float x = SDL_GameControllerGetAxis( pad, ax ) / 32767.0f * stickScale;
+	float y = SDL_GameControllerGetAxis( pad, ay ) / 32767.0f * stickScale;
+	float len = sqrtf( x * x + y * y );
+	if ( len <= deadZone ) {
+		out[0] = out[1] = 0;
+		return;
+	}
+	float shaped = ( len - deadZone ) / ( 1.0f - deadZone );
+	if ( shaped > 1.0f )
+		shaped = 1.0f;
+	out[0] = x / len * shaped;
+	out[1] = y / len * shaped;
+}
+
+static int MenuKey( int b )
+{
+	switch ( b ) {
+	case SDL_CONTROLLER_BUTTON_A: return A_MOUSE1;
+	case SDL_CONTROLLER_BUTTON_B: return A_ESCAPE;
+	case SDL_CONTROLLER_BUTTON_START: return A_ESCAPE;
+	case SDL_CONTROLLER_BUTTON_DPAD_UP: return A_CURSOR_UP;
+	case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return A_CURSOR_DOWN;
+	case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return A_CURSOR_LEFT;
+	case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return A_CURSOR_RIGHT;
+	}
+	return 0;
+}
+
+static int GameKey( int b )
+{
+	if ( b == SDL_CONTROLLER_BUTTON_START )
+		return A_ESCAPE;
+	return A_JOY1 + b;	// JOY1 = A ... JOY15 = d-pad right, SDL's button order
+}
+
+qboolean GLOS_PadFrame( int frameMsec )
+{
+	// SDL turns SIGTERM/SIGINT (appctl stop-application) into SDL_QUIT; without
+	// SDL video IN_ProcessEvents never reads the queue, so do it here.
+	SDL_Event e;
+	while ( SDL_PollEvent( &e ) ) {
+		if ( e.type == SDL_QUIT ) {
+			Cbuf_ExecuteText( EXEC_NOW, "quit Received signal\n" );
+			return qtrue;
+		}
+	}
+
+	if ( !pad )
+		return qfalse;
+
+	SDL_GameControllerUpdate();
+	bool menu = ( Key_GetCatcher() & ( KEYCATCH_UI | KEYCATCH_CONSOLE ) ) != 0 || cls.state != CA_ACTIVE;
+
+	for ( int b = 0; b < SDL_CONTROLLER_BUTTON_MAX; b++ ) {
+		bool down = SDL_GameControllerGetButton( pad, (SDL_GameControllerButton)b ) != 0;
+		if ( down == held[b] )
+			continue;
+		held[b] = down;
+		if ( down ) {
+			heldKey[b] = menu ? MenuKey( b ) : GameKey( b );
+			if ( heldKey[b] )
+				Sys_QueEvent( 0, SE_KEY, heldKey[b], qtrue, 0, NULL );
+		} else if ( heldKey[b] ) {
+			// release the key that was pressed, even if the mode changed meanwhile
+			Sys_QueEvent( 0, SE_KEY, heldKey[b], qfalse, 0, NULL );
+			heldKey[b] = 0;
+		}
+	}
+
+	// triggers as buttons: LT = JOY16, RT = JOY17 (A_JOY1 + 15, 16)
+	static bool trig[2];
+	for ( int t = 0; t < 2; t++ ) {
+		bool down = SDL_GameControllerGetAxis( pad, t ? SDL_CONTROLLER_AXIS_TRIGGERRIGHT : SDL_CONTROLLER_AXIS_TRIGGERLEFT ) > 16384;
+		if ( down != trig[t] ) {
+			trig[t] = down;
+			Sys_QueEvent( 0, SE_KEY, menu ? ( t ? A_MOUSE1 : A_ESCAPE ) : A_JOY1 + 15 + t, down, 0, NULL );
+		}
+	}
+
+	float move[2], look[2];
+	ReadStick( SDL_CONTROLLER_AXIS_LEFTX, SDL_CONTROLLER_AXIS_LEFTY, move );
+	ReadStick( SDL_CONTROLLER_AXIS_RIGHTX, SDL_CONTROLLER_AXIS_RIGHTY, look );
+
+	if ( menu ) {
+		glosPadMove[0] = glosPadMove[1] = glosPadLook[0] = glosPadLook[1] = 0;
+		// cursor: up to 480 virtual pixels a second with either stick
+		float cx = move[0] + look[0], cy = move[1] + look[1];
+		for ( int i = 0; i < 2; i++ ) {
+			cursorFrac[i] += ( i ? cy : cx ) * 480.0f * frameMsec / 1000.0f;
+		}
+		int dx = (int)cursorFrac[0], dy = (int)cursorFrac[1];
+		cursorFrac[0] -= dx; cursorFrac[1] -= dy;
+		if ( dx || dy )
+			Sys_QueEvent( 0, SE_MOUSE, dx, dy, 0, NULL );
+		return qtrue;
+	}
+
+	glosPadMove[0] = move[0];
+	glosPadMove[1] = move[1];
+	for ( int i = 0; i < 2; i++ ) {
+		float m = fabsf( look[i] );
+		glosPadLook[i] = look[i] < 0 ? -powf( m, lookCurve ) : powf( m, lookCurve );
+	}
+	return qtrue;
+}
+
+#endif // GLOS_GLES1

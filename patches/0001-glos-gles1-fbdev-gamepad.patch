+/*
+tr_glos.h: the vanilla renderer's desktop GL 1.x calls, routed to tr_glos.cpp,
+which runs them on GLES 1.1 (ARM's Mali-400 driver on goodluckOS).
+Every qglX becomes glos_X with glX's own prototype.
+*/
+#pragma once
+
+extern decltype(::glAccum) glos_Accum;
+#define qglAccum glos_Accum
+extern decltype(::glAlphaFunc) glos_AlphaFunc;
+#define qglAlphaFunc glos_AlphaFunc
+extern decltype(::glAreTexturesResident) glos_AreTexturesResident;
+#define qglAreTexturesResident glos_AreTexturesResident
+extern decltype(::glArrayElement) glos_ArrayElement;
+#define qglArrayElement glos_ArrayElement
+extern decltype(::glBegin) glos_Begin;
+#define qglBegin glos_Begin
+extern decltype(::glBindTexture) glos_BindTexture;
+#define qglBindTexture glos_BindTexture
+extern decltype(::glBitmap) glos_Bitmap;
+#define qglBitmap glos_Bitmap
+extern decltype(::glBlendFunc) glos_BlendFunc;
+#define qglBlendFunc glos_BlendFunc
+extern decltype(::glCallList) glos_CallList;
+#define qglCallList glos_CallList
+extern decltype(::glCallLists) glos_CallLists;
+#define qglCallLists glos_CallLists
+extern decltype(::glClear) glos_Clear;
+#define qglClear glos_Clear
+extern decltype(::glClearAccum) glos_ClearAccum;
+#define qglClearAccum glos_ClearAccum
+extern decltype(::glClearColor) glos_ClearColor;
+#define qglClearColor glos_ClearColor
+extern decltype(::glClearDepth) glos_ClearDepth;
+#define qglClearDepth glos_ClearDepth
+extern decltype(::glClearIndex) glos_ClearIndex;
+#define qglClearIndex glos_ClearIndex
+extern decltype(::glClearStencil) glos_ClearStencil;
+#define qglClearStencil glos_ClearStencil
+extern decltype(::glClipPlane) glos_ClipPlane;
+#define qglClipPlane glos_ClipPlane
+extern decltype(::glColor3b) glos_Color3b;
+#define qglColor3b glos_Color3b
+extern decltype(::glColor3bv) glos_Color3bv;
+#define qglColor3bv glos_Color3bv
+extern decltype(::glColor3d) glos_Color3d;
+#define qglColor3d glos_Color3d
+extern decltype(::glColor3dv) glos_Color3dv;
+#define qglColor3dv glos_Color3dv
+extern decltype(::glColor3f) glos_Color3f;
+#define qglColor3f glos_Color3f
+extern decltype(::glColor3fv) glos_Color3fv;

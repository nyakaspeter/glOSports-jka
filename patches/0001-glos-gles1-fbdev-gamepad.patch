diff --git a/code/rd-vanilla/tr_glos.cpp b/code/rd-vanilla/tr_glos.cpp
new file mode 100644
index 0000000..6dcc2b3
--- /dev/null
+++ b/code/rd-vanilla/tr_glos.cpp
@@ -0,0 +1,689 @@
+/*
+tr_glos.cpp: the vanilla renderer's desktop GL 1.x calls on GLES 1.1, for ARM's
+Mali-400 driver (r6p2, libMali.so) on goodluckOS.
+
+qgl.h routes every qglX to glos_X here (tr_glos.h). Calls GLES 1.1 has go
+straight through; the rest is emulated:
+- glBegin/glEnd immediate mode: vertexes are collected and drawn from client
+  arrays, quads and polygons as triangles, the game's own arrays put back after.
+- GL_QUADS in glDrawArrays: drawn through a quad index list.
+- texture uploads: GLES wants internal format == format, so RGBA8 data is
+  uploaded as RGBA, or converted to RGB565 / RGBA4444 when the renderer asked
+  for 16-bit textures (r_texturebits 16), which halves texture memory.
+- double-precision calls (glOrtho, glDepthRange, glClearDepth, glClipPlane)
+  go to their float versions; glPolygonMode, glDrawBuffer, display lists and
+  the NV/ARB program extensions are absent (never advertised).
+*/
+#ifdef GLOS_GLES1
+
+#include <dlfcn.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "tr_local.h"
+
+#ifndef GL_CLAMP_TO_EDGE
+#define GL_CLAMP_TO_EDGE 0x812F
+#endif
+#define GL_UNSIGNED_SHORT_5_6_5_ 0x8363
+#define GL_UNSIGNED_SHORT_4_4_4_4_ 0x8033
+#define GL_GENERATE_MIPMAP_ 0x8191
+#define GL_MAX_TEXTURE_UNITS_ 0x84E2
+
+// ---- GLES 1.1 entry points (libMali.so) ----
+
+#define ES_PASS(X) \
+	X(AlphaFunc) X(BlendFunc) X(Clear) X(ClearColor) X(ClearStencil) X(ColorMask) \
+	X(CullFace) X(DeleteTextures) X(DepthFunc) X(DepthMask) X(Disable) X(Enable) \
+	X(Finish) X(Flush) X(Fogf) X(Fogfv) X(FrontFace) X(GenTextures) X(GetError) \
+	X(GetFloatv) X(GetIntegerv) X(Hint) X(IsEnabled) X(IsTexture) X(LineWidth) X(LoadIdentity) \
+	X(LoadMatrixf) X(MatrixMode) X(MultMatrixf) X(PointSize) X(PolygonOffset) X(PopMatrix) \
+	X(PushMatrix) X(Rotatef) X(Scalef) X(Scissor) X(ShadeModel) X(StencilFunc) \
+	X(StencilMask) X(StencilOp) X(TexEnvf) X(TexEnvfv) X(TexEnvi) X(TexEnviv) X(Translatef) \
+	X(Viewport) X(PixelStorei) X(TexParameterf) X(TexParameteri) X(TexParameterfv) \
+	X(BindTexture) X(EnableClientState) X(DisableClientState) X(VertexPointer) \
+	X(ColorPointer) X(TexCoordPointer) X(NormalPointer) X(DrawArrays) X(DrawElements) \
+	X(TexImage2D) X(TexSubImage2D) X(CopyTexImage2D) X(CopyTexSubImage2D) X(ReadPixels) \
+	X(Color4f) X(Color4ub) X(GetString) X(GetBooleanv) X(Normal3f)
+
+#define ES_DECL(n) static decltype(::gl##n) *es##n;
+ES_PASS(ES_DECL)
+
+static void (*esActiveTexture)(GLenum);
+static void (*esClientActiveTexture)(GLenum);
+static void (*esMultiTexCoord4f)(GLenum, GLfloat, GLfloat, GLfloat, GLfloat);
+static void (*esOrthof)(GLfloat, GLfloat, GLfloat, GLfloat, GLfloat, GLfloat);
+static void (*esFrustumf)(GLfloat, GLfloat, GLfloat, GLfloat, GLfloat, GLfloat);
+static void (*esDepthRangef)(GLfloat, GLfloat);
+static void (*esClearDepthf)(GLfloat);
+static void (*esClipPlanef)(GLenum, const GLfloat *);
+
+static char extensions[256];
+static GLint maxUnits = 1;
+
+static void *ES_Sym( void *lib, const char *name )
+{
+	void *p = dlsym( lib, name );
+	if ( !p )
+		Com_Error( ERR_FATAL, "glos: %s missing in libMali.so", name );
+	return p;
+}
+
+void glos_Init( void )
+{
+	void *lib = dlopen( "libMali.so", RTLD_NOW | RTLD_GLOBAL );
+	if ( !lib )
+		Com_Error( ERR_FATAL, "glos: can't load libMali.so: %s", dlerror() );
+#define ES_LOAD(n) *(void **)&es##n = ES_Sym( lib, "gl" #n );
+	ES_PASS(ES_LOAD)
+	*(void **)&esActiveTexture = ES_Sym( lib, "glActiveTexture" );
+	*(void **)&esClientActiveTexture = ES_Sym( lib, "glClientActiveTexture" );
+	*(void **)&esMultiTexCoord4f = ES_Sym( lib, "glMultiTexCoord4f" );
+	*(void **)&esOrthof = ES_Sym( lib, "glOrthof" );
+	*(void **)&esFrustumf = ES_Sym( lib, "glFrustumf" );
+	*(void **)&esDepthRangef = ES_Sym( lib, "glDepthRangef" );
+	*(void **)&esClearDepthf = ES_Sym( lib, "glClearDepthf" );
+	*(void **)&esClipPlanef = ES_Sym( lib, "glClipPlanef" );
+
+	esGetIntegerv( GL_MAX_TEXTURE_UNITS_, &maxUnits );
+	if ( maxUnits > 2 )
+		maxUnits = 2;	// the renderer uses two
+
+	// What the renderer may use: multitexture and GL_ADD are GLES 1.1 core.
+	const char *es = (const char *)esGetString( GL_EXTENSIONS );
+	Q_strncpyz( extensions, "GL_ARB_multitexture GL_EXT_texture_env_add", sizeof( extensions ) );
+	if ( es && strstr( es, "GL_EXT_texture_filter_anisotropic" ) )
+		Q_strcat( extensions, sizeof( extensions ), " GL_EXT_texture_filter_anisotropic" );
+	Com_Printf( "glos: GLES 1.1 %s, %d texture units\n", (const char *)esGetString( GL_VERSION ), maxUnits );
+	Com_Printf( "glos: GLES extensions: %s\n", es ? es : "(none)" );
+}
+
+bool glos_ExtensionSupported( const char *name )
+{
+	const char *p = extensions;
+	size_t n = strlen( name );
+	while ( ( p = strstr( p, name ) ) != NULL ) {
+		if ( ( p == extensions || p[-1] == ' ' ) && ( p[n] == ' ' || p[n] == 0 ) )
+			return true;
+		p += n;
+	}
+	return false;
+}
+
+// ---- client array state, tracked so immediate mode can put it back ----
+
+struct arrayState_t {
+	bool		enabled;
+	GLint		size;
+	GLenum		type;
+	GLsizei		stride;
+	const void	*ptr;
+};
+
+static arrayState_t vertexArray, colorArray, normalArray, texArray[2];
+static int clientUnit, activeUnit;
+static GLubyte curColor[4] = { 255, 255, 255, 255 };
+static GLuint boundTex[2];
+
+static arrayState_t *ArrayFor( GLenum cap )
+{
+	switch ( cap ) {
+	case GL_VERTEX_ARRAY: return &vertexArray;
+	case GL_COLOR_ARRAY: return &colorArray;
+	case GL_NORMAL_ARRAY: return &normalArray;
+	case GL_TEXTURE_COORD_ARRAY: return &texArray[clientUnit];
+	}
+	return NULL;
+}
+
+void glos_EnableClientState( GLenum cap )
+{
+	arrayState_t *a = ArrayFor( cap );
+	if ( a ) a->enabled = true;
+	esEnableClientState( cap );
+}
+
+void glos_DisableClientState( GLenum cap )
+{
+	arrayState_t *a = ArrayFor( cap );
+	if ( a ) a->enabled = false;
+	esDisableClientState( cap );
+}
+
+static void SetArray( arrayState_t *a, GLint size, GLenum type, GLsizei stride, const void *ptr )
+{
+	a->size = size; a->type = type; a->stride = stride; a->ptr = ptr;
+}
+
+void glos_VertexPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr )
+{
+	SetArray( &vertexArray, size, type, stride, ptr );
+	esVertexPointer( size, type, stride, ptr );
+}
+
+void glos_ColorPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr )
+{
+	SetArray( &colorArray, size, type, stride, ptr );
+	esColorPointer( size, type, stride, ptr );
+}
+
+void glos_NormalPointer( GLenum type, GLsizei stride, const GLvoid *ptr )
+{
+	SetArray( &normalArray, 3, type, stride, ptr );
+	esNormalPointer( type, stride, ptr );
+}
+
+void glos_TexCoordPointer( GLint size, GLenum type, GLsizei stride, const GLvoid *ptr )
+{
+	SetArray( &texArray[clientUnit], size, type, stride, ptr );
+	esTexCoordPointer( size, type, stride, ptr );
+}
+
+static void APIENTRY glos_ClientActiveTexture( GLenum unit )
+{
+	clientUnit = unit - GL_TEXTURE0_ARB;
+	esClientActiveTexture( unit );
+}
+
+static void APIENTRY glos_ActiveTexture( GLenum unit )
+{
+	activeUnit = unit - GL_TEXTURE0_ARB;
+	esActiveTexture( unit );
+}
+
+// ---- immediate mode ----
+
+struct immVert_t {
+	float	xyz[3];
+	float	st[2][2];
+	GLubyte	rgba[4];
+};
+
+#define IMM_MAX 4096
+static immVert_t imm[IMM_MAX];
+static int immCount;
+static GLenum immPrim;
+static bool inBegin;
+static float curST[2][2];
+static unsigned short immIndexes[IMM_MAX * 3 / 2];
+
+void glos_Begin( GLenum mode )
+{
+	immPrim = mode;
+	immCount = 0;
+	inBegin = true;
+}
+
+static void ImmVertex( float x, float y, float z )
+{
+	if ( immCount >= IMM_MAX )
+		return;
+	immVert_t *v = &imm[immCount++];
+	v->xyz[0] = x; v->xyz[1] = y; v->xyz[2] = z;
+	memcpy( v->st, curST, sizeof( curST ) );
+	memcpy( v->rgba, curColor, 4 );
+}
+
+void glos_Vertex2f( GLfloat x, GLfloat y ) { ImmVertex( x, y, 0 ); }
+void glos_Vertex2fv( const GLfloat *v ) { ImmVertex( v[0], v[1], 0 ); }
+void glos_Vertex2i( GLint x, GLint y ) { ImmVertex( x, y, 0 ); }
+void glos_Vertex3f( GLfloat x, GLfloat y, GLfloat z ) { ImmVertex( x, y, z ); }
+void glos_Vertex3fv( const GLfloat *v ) { ImmVertex( v[0], v[1], v[2] ); }
+
+void glos_TexCoord2f( GLfloat s, GLfloat t ) { curST[0][0] = s; curST[0][1] = t; }
+void glos_TexCoord2fv( const GLfloat *v ) { curST[0][0] = v[0]; curST[0][1] = v[1]; }
+
+static void APIENTRY glos_MultiTexCoord2f( GLenum unit, GLfloat s, GLfloat t )
+{
+	int u = unit - GL_TEXTURE0_ARB;
+	if ( u < 0 || u > 1 )
+		return;
+	curST[u][0] = s; curST[u][1] = t;
+	if ( !inBegin )
+		esMultiTexCoord4f( unit, s, t, 0, 1 );
+}
+
+static GLubyte ToByte( float f )
+{
+	if ( f <= 0 ) return 0;
+	if ( f >= 1 ) return 255;
+	return (GLubyte)( f * 255.0f + 0.5f );
+}
+
+static void SetColor( GLubyte r, GLubyte g, GLubyte b, GLubyte a )
+{
+	curColor[0] = r; curColor[1] = g; curColor[2] = b; curColor[3] = a;
+	if ( !inBegin )
+		esColor4ub( r, g, b, a );
+}
+
+void glos_Color3f( GLfloat r, GLfloat g, GLfloat b ) { SetColor( ToByte( r ), ToByte( g ), ToByte( b ), 255 ); }
+void glos_Color3fv( const GLfloat *v ) { glos_Color3f( v[0], v[1], v[2] ); }
+void glos_Color4f( GLfloat r, GLfloat g, GLfloat b, GLfloat a ) { SetColor( ToByte( r ), ToByte( g ), ToByte( b ), ToByte( a ) ); }
+void glos_Color4fv( const GLfloat *v ) { glos_Color4f( v[0], v[1], v[2], v[3] ); }
+void glos_Color3ub( GLubyte r, GLubyte g, GLubyte b ) { SetColor( r, g, b, 255 ); }
+void glos_Color4ub( GLubyte r, GLubyte g, GLubyte b, GLubyte a ) { SetColor( r, g, b, a ); }
+void glos_Color4ubv( const GLubyte *v ) { SetColor( v[0], v[1], v[2], v[3] ); }
+
+// one vertex from the game's float vertex/texcoord and byte color arrays
+void glos_ArrayElement( GLint i )
+{
+	if ( texArray[0].enabled && texArray[0].type == GL_FLOAT ) {
+		const float *st = (const float *)( (const byte *)texArray[0].ptr + i * ( texArray[0].stride ? texArray[0].stride : texArray[0].size * 4 ) );
+		curST[0][0] = st[0]; curST[0][1] = st[1];
+	}
+	if ( colorArray.enabled && colorArray.type == GL_UNSIGNED_BYTE ) {
+		const GLubyte *c = (const GLubyte *)colorArray.ptr + i * ( colorArray.stride ? colorArray.stride : 4 );
+		memcpy( curColor, c, 4 );
+	}
+	if ( vertexArray.enabled && vertexArray.type == GL_FLOAT ) {
+		const float *v = (const float *)( (const byte *)vertexArray.ptr + i * ( vertexArray.stride ? vertexArray.stride : vertexArray.size * 4 ) );
+		ImmVertex( v[0], v[1], vertexArray.size > 2 ? v[2] : 0 );
+	}
+}
+
+static void RestoreArray( GLenum cap, const arrayState_t *a )
+{
+	if ( a->enabled ) esEnableClientState( cap ); else esDisableClientState( cap );
+}
+
+void glos_End( void )
+{
+	inBegin = false;
+	if ( immCount == 0 )
+		return;
+
+	GLenum prim = immPrim;
+	int count = immCount;
+	bool indexed = false;
+	switch ( immPrim ) {
+	case GL_QUADS:
+		count = 0;
+		for ( int q = 0; q + 3 < immCount; q += 4 ) {
+			immIndexes[count++] = q; immIndexes[count++] = q + 1; immIndexes[count++] = q + 2;
+			immIndexes[count++] = q + 2; immIndexes[count++] = q + 3; immIndexes[count++] = q;
+		}
+		prim = GL_TRIANGLES;
+		indexed = true;
+		break;
+	case GL_POLYGON:
+		prim = GL_TRIANGLE_FAN;
+		break;
+	case GL_QUAD_STRIP:
+		prim = GL_TRIANGLE_STRIP;
+		break;
+	}
+
+	esVertexPointer( 3, GL_FLOAT, sizeof( immVert_t ), imm[0].xyz );
+	esEnableClientState( GL_VERTEX_ARRAY );
+	esColorPointer( 4, GL_UNSIGNED_BYTE, sizeof( immVert_t ), imm[0].rgba );
+	esEnableClientState( GL_COLOR_ARRAY );
+	if ( normalArray.enabled )
+		esDisableClientState( GL_NORMAL_ARRAY );
+	for ( int u = 0; u < maxUnits; u++ ) {
+		esClientActiveTexture( GL_TEXTURE0_ARB + u );
+		esTexCoordPointer( 2, GL_FLOAT, sizeof( immVert_t ), imm[0].st[u] );
+		esEnableClientState( GL_TEXTURE_COORD_ARRAY );
+	}
+
+	if ( indexed )
+		esDrawElements( prim, count, GL_UNSIGNED_SHORT, immIndexes );
+	else
+		esDrawArrays( prim, 0, count );
+
+	// put the game's arrays back
+	for ( int u = 0; u < maxUnits; u++ ) {
+		const arrayState_t *a = &texArray[u];
+		esClientActiveTexture( GL_TEXTURE0_ARB + u );
+		if ( a->ptr )
+			esTexCoordPointer( a->size, a->type, a->stride, a->ptr );
+		RestoreArray( GL_TEXTURE_COORD_ARRAY, a );
+	}
+	esClientActiveTexture( GL_TEXTURE0_ARB + clientUnit );
+	if ( vertexArray.ptr )
+		esVertexPointer( vertexArray.size, vertexArray.type, vertexArray.stride, vertexArray.ptr );
+	RestoreArray( GL_VERTEX_ARRAY, &vertexArray );
+	if ( colorArray.ptr )
+		esColorPointer( colorArray.size, colorArray.type, colorArray.stride, colorArray.ptr );
+	RestoreArray( GL_COLOR_ARRAY, &colorArray );
+	if ( normalArray.enabled )
+		esEnableClientState( GL_NORMAL_ARRAY );
+	// the current color is undefined after drawing with a color array
+	esColor4ub( curColor[0], curColor[1], curColor[2], curColor[3] );
+}
+
+// ---- draws ----
+
+static unsigned short *quadIndexes;
+static int quadIndexVerts;
+
+void glos_DrawArrays( GLenum mode, GLint first, GLsizei count )
+{
+	if ( mode != GL_QUADS ) {
+		esDrawArrays( mode, first, count );
+		return;
+	}
+	int quads = count / 4;
+	if ( first + count > 65536 || quads == 0 )
+		return;
+	if ( first + count > quadIndexVerts ) {
+		quadIndexVerts = first + count;
+		quadIndexes = (unsigned short *)realloc( quadIndexes, quadIndexVerts / 4 * 6 * sizeof( unsigned short ) + 12 );
+	}
+	unsigned short *ix = quadIndexes;
+	for ( int q = 0; q < quads; q++ ) {
+		int b = first + q * 4;
+		*ix++ = b; *ix++ = b + 1; *ix++ = b + 2;
+		*ix++ = b + 2; *ix++ = b + 3; *ix++ = b;
+	}
+	esDrawElements( GL_TRIANGLES, quads * 6, GL_UNSIGNED_SHORT, quadIndexes );
+}
+
+void glos_DrawElements( GLenum mode, GLsizei count, GLenum type, const GLvoid *indexes )
+{
+	if ( type == GL_UNSIGNED_INT ) {
+		static unsigned short *shorts;
+		static int max;
+		if ( count > max ) {
+			max = count;
+			shorts = (unsigned short *)realloc( shorts, max * sizeof( unsigned short ) );
+		}
+		const unsigned int *in = (const unsigned int *)indexes;
+		for ( int i = 0; i < count; i++ )
+			shorts[i] = in[i];
+		esDrawElements( mode, count, GL_UNSIGNED_SHORT, shorts );
+		return;
+	}
+	esDrawElements( mode, count, type, indexes );
+}
+
+// ---- state ----
+
+static bool Unsupported( GLenum cap )
+{
+	switch ( cap ) {
+	case GL_TEXTURE_GEN_S: case GL_TEXTURE_GEN_T: case GL_TEXTURE_GEN_R: case GL_TEXTURE_GEN_Q:
+	case GL_POLYGON_OFFSET_LINE: case GL_POLYGON_STIPPLE: case GL_LINE_STIPPLE:
+	case GL_TEXTURE_RECTANGLE_ARB: case GL_REGISTER_COMBINERS_NV:
+	case GL_VERTEX_PROGRAM_ARB: case GL_FRAGMENT_PROGRAM_ARB:
+	case GL_TEXTURE_1D:
+		return true;
+	}
+	return false;
+}
+
+void glos_Enable( GLenum cap ) { if ( !Unsupported( cap ) ) esEnable( cap ); }
+void glos_Disable( GLenum cap ) { if ( !Unsupported( cap ) ) esDisable( cap ); }
+GLboolean glos_IsEnabled( GLenum cap ) { return Unsupported( cap ) ? GL_FALSE : esIsEnabled( cap ); }
+
+void glos_Fogi( GLenum pname, GLint param ) { if ( pname != GL_FOG_DISTANCE_MODE_NV ) esFogf( pname, (GLfloat)param ); }
+void glos_Fogf( GLenum pname, GLfloat param ) { esFogf( pname, param ); }
+void glos_Fogfv( GLenum pname, const GLfloat *params ) { esFogfv( pname, params ); }
+
+void glos_ClearDepth( GLclampd d ) { esClearDepthf( (GLfloat)d ); }
+void glos_DepthRange( GLclampd n, GLclampd f ) { esDepthRangef( (GLfloat)n, (GLfloat)f ); }
+void glos_Ortho( GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f ) { esOrthof( l, r, b, t, n, f ); }
+void glos_Frustum( GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f ) { esFrustumf( l, r, b, t, n, f ); }
+void glos_ClipPlane( GLenum plane, const GLdouble *eq )
+{
+	GLfloat f[4] = { (GLfloat)eq[0], (GLfloat)eq[1], (GLfloat)eq[2], (GLfloat)eq[3] };
+	esClipPlanef( plane, f );
+}
+
+void glos_PolygonMode( GLenum face, GLenum mode ) {}
+void glos_DrawBuffer( GLenum mode ) {}
+void glos_CallList( GLuint list ) {}
+void glos_NewList( GLuint list, GLenum mode ) {}
+void glos_EndList( void ) {}
+GLuint glos_GenLists( GLsizei range ) { return 0; }
+void glos_DeleteLists( GLuint list, GLsizei range ) {}
+
+static GLenum WrapMode( GLenum pname, GLint param )
+{
+	if ( ( pname == GL_TEXTURE_WRAP_S || pname == GL_TEXTURE_WRAP_T ) && param == GL_CLAMP )
+		return GL_CLAMP_TO_EDGE;
+	return param;
+}
+
+static bool TexParamOk( GLenum target, GLenum pname )
+{
+	if ( target != GL_TEXTURE_2D )
+		return false;
+	switch ( pname ) {
+	case GL_TEXTURE_MIN_FILTER: case GL_TEXTURE_MAG_FILTER:
+	case GL_TEXTURE_WRAP_S: case GL_TEXTURE_WRAP_T: case GL_GENERATE_MIPMAP_:
+		return true;
+	case GL_TEXTURE_MAX_ANISOTROPY_EXT:
+		return glos_ExtensionSupported( "GL_EXT_texture_filter_anisotropic" );
+	}
+	return false;
+}
+
+void glos_TexParameteri( GLenum target, GLenum pname, GLint param )
+{
+	if ( TexParamOk( target, pname ) )
+		esTexParameteri( target, pname, WrapMode( pname, param ) );
+}
+
+void glos_TexParameterf( GLenum target, GLenum pname, GLfloat param )
+{
+	if ( !TexParamOk( target, pname ) )
+		return;
+	if ( pname == GL_TEXTURE_MAX_ANISOTROPY_EXT )
+		esTexParameterf( target, pname, param );
+	else
+		esTexParameteri( target, pname, WrapMode( pname, (GLint)param ) );
+}
+
+void glos_TexParameterfv( GLenum target, GLenum pname, const GLfloat *params )
+{
+	glos_TexParameterf( target, pname, params[0] );
+}
+
+void glos_TexEnvf( GLenum target, GLenum pname, GLfloat param ) { esTexEnvi( target, pname, (GLint)param ); }
+void glos_TexEnvi( GLenum target, GLenum pname, GLint param ) { esTexEnvi( target, pname, param ); }
+void glos_TexEnvfv( GLenum target, GLenum pname, const GLfloat *params ) { esTexEnvfv( target, pname, params ); }
+
+// ---- textures ----
+
+enum { TEX_RGBA8, TEX_565, TEX_4444 };
+
+#define MAX_TRACKED_TEXTURES 16384
+static byte texKind[MAX_TRACKED_TEXTURES];
+static byte *convBuf;
+static int convBufSize;
+
+void glos_BindTexture( GLenum target, GLuint tex )
+{
+	if ( target != GL_TEXTURE_2D )
+		return;
+	boundTex[activeUnit & 1] = tex;
+	esBindTexture( target, tex );
+}
+
+static int KindOf( GLint internal )
+{
+	switch ( internal ) {
+	case GL_RGB5: case GL_RGB4: case GL_R3_G3_B2: case GL_RGB4_S3TC:
+		return TEX_565;
+	case GL_RGBA4: case GL_RGB5_A1: case GL_RGBA2:
+		return TEX_4444;
+	}
+	return TEX_RGBA8;
+}
+
+static byte *ConvBuf( int bytes )
+{
+	if ( bytes > convBufSize ) {
+		convBufSize = bytes;
+		convBuf = (byte *)realloc( convBuf, bytes );
+	}
+	return convBuf;
+}
+
+// RGBA8 pixels to 16-bit ones; returns the converted data.
+static const void *Convert( int kind, int w, int h, const byte *src )
+{
+	int n = w * h;
+	unsigned short *dst = (unsigned short *)ConvBuf( n * 2 );
+	if ( kind == TEX_565 ) {
+		for ( int i = 0; i < n; i++, src += 4 )
+			dst[i] = ( ( src[0] >> 3 ) << 11 ) | ( ( src[1] >> 2 ) << 5 ) | ( src[2] >> 3 );
+	} else {
+		for ( int i = 0; i < n; i++, src += 4 )
+			dst[i] = ( ( src[0] >> 4 ) << 12 ) | ( ( src[1] >> 4 ) << 8 ) | ( ( src[2] >> 4 ) << 4 ) | ( src[3] >> 4 );
+	}
+	return dst;
+}
+
+static void Upload16( bool sub, int kind, GLint level, GLint x, GLint y, GLsizei w, GLsizei h, const GLvoid *pixels )
+{
+	GLenum fmt = kind == TEX_565 ? GL_RGB : GL_RGBA;
+	GLenum type = kind == TEX_565 ? GL_UNSIGNED_SHORT_5_6_5_ : GL_UNSIGNED_SHORT_4_4_4_4_;
+	const void *data = pixels ? Convert( kind, w, h, (const byte *)pixels ) : NULL;
+	esPixelStorei( GL_UNPACK_ALIGNMENT, 2 );
+	if ( sub )
+		esTexSubImage2D( GL_TEXTURE_2D, level, x, y, w, h, fmt, type, data );
+	else
+		esTexImage2D( GL_TEXTURE_2D, level, fmt, w, h, 0, fmt, type, data );
+	esPixelStorei( GL_UNPACK_ALIGNMENT, 4 );
+}
+
+void glos_TexImage2D( GLenum target, GLint level, GLint internal, GLsizei w, GLsizei h, GLint border, GLenum format, GLenum type, const GLvoid *pixels )
+{
+	if ( target != GL_TEXTURE_2D )
+		return;
+	GLuint tex = boundTex[activeUnit & 1];
+	if ( format == GL_RGBA && type == GL_UNSIGNED_BYTE ) {
+		int kind = KindOf( internal );
+		if ( tex < MAX_TRACKED_TEXTURES )
+			texKind[tex] = kind;
+		if ( kind != TEX_RGBA8 ) {
+			Upload16( false, kind, level, 0, 0, w, h, pixels );
+			return;
+		}
+		esTexImage2D( target, level, GL_RGBA, w, h, 0, GL_RGBA, type, pixels );
+		return;
+	}
+	if ( tex < MAX_TRACKED_TEXTURES )
+		texKind[tex] = TEX_RGBA8;
+	esTexImage2D( target, level, format, w, h, 0, format, type, pixels );
+}
+
+void glos_TexSubImage2D( GLenum target, GLint level, GLint x, GLint y, GLsizei w, GLsizei h, GLenum format, GLenum type, const GLvoid *pixels )
+{
+	if ( target != GL_TEXTURE_2D )
+		return;
+	GLuint tex = boundTex[activeUnit & 1];
+	int kind = tex < MAX_TRACKED_TEXTURES ? texKind[tex] : TEX_RGBA8;
+	if ( kind != TEX_RGBA8 && format == GL_RGBA && type == GL_UNSIGNED_BYTE ) {
+		Upload16( true, kind, level, x, y, w, h, pixels );
+		return;
+	}
+	esTexSubImage2D( target, level, x, y, w, h, format, type, pixels );
+}
+
+void glos_CopyTexImage2D( GLenum target, GLint level, GLenum internal, GLint x, GLint y, GLsizei w, GLsizei h, GLint border )
+{
+	if ( target != GL_TEXTURE_2D )
+		return;
+	esCopyTexImage2D( target, level, GL_RGB, x, y, w, h, 0 );
+}
+
+void glos_CopyTexSubImage2D( GLenum target, GLint level, GLint xo, GLint yo, GLint x, GLint y, GLsizei w, GLsizei h )
+{
+	if ( target == GL_TEXTURE_2D )
+		esCopyTexSubImage2D( target, level, xo, yo, x, y, w, h );
+}
+
+void glos_ReadPixels( GLint x, GLint y, GLsizei w, GLsizei h, GLenum format, GLenum type, GLvoid *pixels )
+{
+	if ( format == GL_RGBA && type == GL_UNSIGNED_BYTE ) {
+		esReadPixels( x, y, w, h, format, type, pixels );
+		return;
+	}
+	if ( format == GL_RGB && type == GL_UNSIGNED_BYTE ) {
+		byte *rgba = ConvBuf( w * h * 4 );
+		esReadPixels( x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba );
+		byte *out = (byte *)pixels;
+		for ( int i = 0; i < w * h; i++ ) {
+			out[i * 3] = rgba[i * 4]; out[i * 3 + 1] = rgba[i * 4 + 1]; out[i * 3 + 2] = rgba[i * 4 + 2];
+		}
+		return;
+	}
+	// depth and stencil can't be read on GLES: report "nothing in front"
+	if ( format == GL_DEPTH_COMPONENT && type == GL_FLOAT ) {
+		for ( int i = 0; i < w * h; i++ )
+			((float *)pixels)[i] = 1.0f;
+		return;
+	}
+	memset( pixels, 0, w * h );
+}
+
+// ---- queries and plain pass-throughs ----
+
+const GLubyte *glos_GetString( GLenum name )
+{
+	if ( name == GL_EXTENSIONS )
+		return (const GLubyte *)extensions;
+	return esGetString( name );
+}
+
+void glos_GetIntegerv( GLenum pname, GLint *params )
+{
+	if ( pname == GL_MAX_TEXTURE_UNITS_ ) {
+		*params = maxUnits;
+		return;
+	}
+	esGetIntegerv( pname, params );
+}
+
+void glos_AlphaFunc( GLenum f, GLclampf r ) { esAlphaFunc( f, r ); }
+void glos_BlendFunc( GLenum s, GLenum d ) { esBlendFunc( s, d ); }
+void glos_Clear( GLbitfield m ) { esClear( m ); }
